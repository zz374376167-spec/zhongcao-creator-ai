# Dify Workflow API 配置（复制为 .env.local 使用）
# 部署到 Vercel 时，在项目 Settings -> Environment Variables 中配置同名变量

# Dify API 基础地址（云端版为 https://api.dify.ai/v1）
DIFY_API_URL=https://api.dify.ai/v1

# 商品分析 Workflow 的 API Key（Dify 控制台 -> 工作流 -> API 访问 -> API 密钥）
DIFY_ANALYZE_API_KEY=app-xxxxx

# 内容生成 Workflow 的 API Key
DIFY_CONTENT_API_KEY=app-xxxxx
